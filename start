#!/bin/bash

# LedgerLoop Smart Service Manager
# Handles port management, session tracking, and verbose logging

set -euo pipefail

# Colors and formatting
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# Configuration
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOGS_DIR="$PROJECT_ROOT/logs"
SESSIONS_DIR="$PROJECT_ROOT/.sessions"
BACKEND_DIR="$PROJECT_ROOT/apps/backend"
WEB_DIR="$PROJECT_ROOT/apps/web"

# Default ports (will auto-find available ones)
BACKEND_BASE_PORT=8000
WEB_BASE_PORT=3000

# Session tracking
SESSION_ID="$(date +%Y%m%d_%H%M%S)"
BACKEND_PID_FILE="$SESSIONS_DIR/backend.pid"
WEB_PID_FILE="$SESSIONS_DIR/web.pid"
BACKEND_PORT_FILE="$SESSIONS_DIR/backend.port"
WEB_PORT_FILE="$SESSIONS_DIR/web.port"

# Logging
VERBOSE=${VERBOSE:-0}
LOG_TIMESTAMP="$(date '+%Y-%m-%d_%H%M%S')"

# Initialize directories
mkdir -p "$LOGS_DIR" "$SESSIONS_DIR"

# Utility functions
log() {
    local level="$1"
    shift
    local timestamp="$(date '+%H:%M:%S')"
    case "$level" in
        ERROR)   echo -e "${RED}[ERROR $timestamp]${NC} $*" >&2 ;;
        WARN)    echo -e "${YELLOW}[WARN  $timestamp]${NC} $*" >&2 ;;
        INFO)    echo -e "${BLUE}[INFO  $timestamp]${NC} $*" ;;
        SUCCESS) echo -e "${GREEN}[OK    $timestamp]${NC} $*" ;;
        DEBUG)   [[ $VERBOSE -ge 1 ]] && echo -e "${PURPLE}[DEBUG $timestamp]${NC} $*" ;;
        TRACE)   [[ $VERBOSE -ge 2 ]] && echo -e "${CYAN}[TRACE $timestamp]${NC} $*" ;;
    esac
}

verbose() {
    log DEBUG "$@"
}

trace() {
    log TRACE "$@"
}

# Port management
find_available_port() {
    local base_port="$1"
    local port="$base_port"

    verbose "Finding available port starting from $base_port" >&2

    port_in_use() {
        local p="$1"
        # Try lsof first
        if lsof -ti ":$p" >/dev/null 2>&1; then
            return 0
        fi
        # Fallback to ss if available
        if command -v ss >/dev/null 2>&1; then
            if ss -ltnp 2>/dev/null | grep -qE "[:\.]$p\s"; then
                return 0
            fi
        fi
        return 1
    }

    while [[ $port -lt $((base_port + 100)) ]]; do
        if ! port_in_use "$port"; then
            trace "Port $port is available" >&2
            echo "$port"
            return 0
        fi
        trace "Port $port is in use, trying next" >&2
        ((port++))
    done

    log ERROR "No available ports found in range $base_port-$((base_port + 99))"
    return 1
}

# Process management
kill_process_by_pid_file() {
    local pid_file="$1"
    local service_name="$2"
    
    if [[ -f "$pid_file" ]]; then
        local pid
        pid="$(cat "$pid_file")"
        verbose "Found $service_name PID file with PID: $pid"
        
        if kill -0 "$pid" 2>/dev/null; then
            log INFO "Stopping $service_name (PID: $pid)"
            kill -TERM "$pid" 2>/dev/null || true
            
            # Wait for graceful shutdown
            local count=0
            while kill -0 "$pid" 2>/dev/null && [[ $count -lt 10 ]]; do
                sleep 0.5
                ((count++))
            done
            
            # Force kill if still running
            if kill -0 "$pid" 2>/dev/null; then
                log WARN "Force killing $service_name (PID: $pid)"
                kill -KILL "$pid" 2>/dev/null || true
            fi
        else
            verbose "$service_name PID $pid is not running"
        fi
        
        rm -f "$pid_file"
    else
        verbose "No $service_name PID file found"
    fi
}

cleanup_conflicting_processes() {
    log INFO "Cleaning up any conflicting processes"
    
    # Kill processes holding database locks
    verbose "Checking for database lock conflicts"
    if command -v fuser >/dev/null 2>&1; then
        if [[ -e "$HOME/.ledgerloop/ledgerloop.duckdb" ]] && fuser "$HOME/.ledgerloop/ledgerloop.duckdb" 2>/dev/null; then
            log WARN "Found processes holding database locks, killing them"
            fuser -k "$HOME/.ledgerloop/ledgerloop.duckdb" 2>/dev/null || true
            sleep 1
        fi
    else
        verbose "fuser not available; skipping DB lock cleanup"
    fi
    
    # Kill any uvicorn/fastapi processes
    if command -v pgrep >/dev/null 2>&1; then
        if pgrep -f "uvicorn.*ledgerloop" >/dev/null 2>&1; then
            log WARN "Found conflicting uvicorn processes, killing them"
            if command -v pkill >/dev/null 2>&1; then
                pkill -f "uvicorn.*ledgerloop" || true
            fi
            sleep 1
        fi
    else
        verbose "pgrep not available; skipping uvicorn cleanup"
    fi
    
    # Kill any Next.js processes on our ports (check regardless of netstat/IPv6)
    if command -v lsof >/dev/null 2>&1; then
        for port in $(seq $WEB_BASE_PORT $((WEB_BASE_PORT + 20))); do
            pids=$(lsof -ti ":$port" 2>/dev/null || true)
            if [[ -n "$pids" ]]; then
                verbose "Killing processes on port $port: $pids"
                kill -TERM $pids 2>/dev/null || true
                sleep 0.5
                kill -KILL $pids 2>/dev/null || true
            fi
        done
    else
        verbose "lsof not available; skipping port-based process cleanup"
    fi
    
    # Kill any remaining Next.js processes
    if command -v pgrep >/dev/null 2>&1; then
        if pgrep -f "next.*dev\|next-server" >/dev/null 2>&1; then
            verbose "Killing remaining Next.js processes"
            if command -v pkill >/dev/null 2>&1; then
                pkill -f "next.*dev\|next-server" 2>/dev/null || true
            fi
            sleep 1
        fi
    fi
}

# Kill any process listening on a given port (best-effort)
kill_on_port() {
    local port="$1"
    if [[ -z "$port" ]]; then return; fi
    if command -v lsof >/dev/null 2>&1; then
        local pids
        pids=$(lsof -ti ":$port" 2>/dev/null || true)
        if [[ -n "$pids" ]]; then
            log WARN "Killing processes on port $port: $pids"
            kill -TERM $pids 2>/dev/null || true
            sleep 0.5
            kill -KILL $pids 2>/dev/null || true
        fi
    elif command -v ss >/dev/null 2>&1; then
        local pids
        pids=$(ss -ltnp 2>/dev/null | awk -v p=":$port" '$4 ~ p {print $6}' | sed 's/,.*pid=\([0-9]*\).*/\1/g' | tr '\n' ' ')
        if [[ -n "$pids" ]]; then
            log WARN "Killing processes on port $port: $pids"
            kill -TERM $pids 2>/dev/null || true
            sleep 0.5
            kill -KILL $pids 2>/dev/null || true
        fi
    fi
}

# Service management
start_backend() {
    log INFO "Starting LedgerLoop backend..."
    
    # Find available port
    local port
    port="$(find_available_port $BACKEND_BASE_PORT)"
    echo "$port" > "$BACKEND_PORT_FILE"
    
    # Setup logging
    local log_file="$LOGS_DIR/backend-$LOG_TIMESTAMP.log"
    local combined_log="$LOGS_DIR/backend.log"
    
    verbose "Backend will use port $port"
    verbose "Backend logs: $log_file"
    
    cd "$BACKEND_DIR"
    
    # Start backend in background
    (
        source "../../.venv/bin/activate"
        export PYTHONPATH="$BACKEND_DIR/src"
        # Allow web origin in dev by default
        export LEDGERLOOP_CORS="${LEDGERLOOP_CORS:-*}"
        # AI provider defaults (can be overridden in environment before invoking this script)
        export LEDGERLOOP_AI_PROVIDER="${LEDGERLOOP_AI_PROVIDER:-lmstudio}"
        export LEDGERLOOP_AI_LMSTUDIO_BASE_URL="${LEDGERLOOP_AI_LMSTUDIO_BASE_URL:-http://10.5.0.2:1234/v1}"
        # Default model to use across categorize/merchant/anomaly unless overridden individually
        export LEDGERLOOP_AI_LMSTUDIO_MODEL="${LEDGERLOOP_AI_LMSTUDIO_MODEL:-qwen/qwen3-4b-2507}"
        export LEDGERLOOP_AI_MODEL_CATEGORIZE="${LEDGERLOOP_AI_MODEL_CATEGORIZE:-$LEDGERLOOP_AI_LMSTUDIO_MODEL}"
        export LEDGERLOOP_AI_MODEL_MERCHANT="${LEDGERLOOP_AI_MODEL_MERCHANT:-$LEDGERLOOP_AI_LMSTUDIO_MODEL}"
        export LEDGERLOOP_AI_MODEL_ANOMALY="${LEDGERLOOP_AI_MODEL_ANOMALY:-$LEDGERLOOP_AI_LMSTUDIO_MODEL}"
        # Concurrency and batching defaults to avoid resource spikes on laptops
        export LEDGERLOOP_AI_MAX_CONCURRENCY="${LEDGERLOOP_AI_MAX_CONCURRENCY:-1}"
        export LEDGERLOOP_AI_BATCH_SIZE="${LEDGERLOOP_AI_BATCH_SIZE:-10}"
        # Dev bypass for admin token (do not use in production)
        export LEDGERLOOP_DEV_ALLOW_ADMIN="${LEDGERLOOP_DEV_ALLOW_ADMIN:-true}"
        exec uvicorn ledgerloop.api.main:app \
            --host 127.0.0.1 \
            --port "$port" \
            --log-level info \
            --access-log \
            2>&1
    ) > "$log_file" 2>&1 &
    
    local pid=$!
    echo "$pid" > "$BACKEND_PID_FILE"
    
    # Create symlink to latest log
    ln -sf "$log_file" "$combined_log"
    
    log INFO "Backend started (PID: $pid, Port: $port)"
    verbose "Waiting for backend to be ready..."
    
    # Wait for backend to be ready
    local count=0
    local max_wait=30
    while [[ $count -lt $max_wait ]]; do
        if curl -s "http://127.0.0.1:$port/api/health" >/dev/null 2>&1; then
            log SUCCESS "Backend is ready and responding on port $port"
            echo -e "${BLUE}Backend URL:${NC} http://127.0.0.1:$port"
            echo -e "${BLUE}API Docs:${NC}   http://127.0.0.1:$port/docs"
            return 0
        fi
        
        if ! kill -0 "$pid" 2>/dev/null; then
            log ERROR "Backend process died during startup"
            log ERROR "Check logs: $log_file"
            tail -10 "$log_file" 2>/dev/null || true
            return 1
        fi
        
        if [[ $((count % 5)) -eq 0 ]] && [[ $count -gt 0 ]]; then
            echo -n " [${count}s]"
        else
            echo -n "."
        fi
        sleep 1
        ((count++))
    done
    
    log ERROR "Backend failed to start within ${max_wait}s"
    log ERROR "Check logs: $log_file"
    tail -10 "$log_file" 2>/dev/null || true
    return 1
}

start_web() {
    log INFO "Starting LedgerLoop web interface..."
    
    # Find available port
    local port
    port="$(find_available_port $WEB_BASE_PORT)"
    echo "$port" > "$WEB_PORT_FILE"
    
    # Setup logging
    local log_file="$LOGS_DIR/web-$LOG_TIMESTAMP.log"
    local combined_log="$LOGS_DIR/web.log"
    
    verbose "Web interface will use port $port"
    verbose "Web logs: $log_file"
    
    cd "$WEB_DIR"
    
    # Start web interface in background
    (
        export PORT="$port"
        # Derive API base from running backend port if available
        backend_port="$(cat "$BACKEND_PORT_FILE" 2>/dev/null || echo "$BACKEND_BASE_PORT")"
        export NEXT_PUBLIC_API_BASE="http://127.0.0.1:${backend_port}/api"
        # Feature flag for new UI flows (default off)
        export NEXT_PUBLIC_LEDGERLOOP_UI_V1_COMPLETE="${NEXT_PUBLIC_LEDGERLOOP_UI_V1_COMPLETE:-false}"
        exec npm run dev -- -p "$port" 2>&1
    ) > "$log_file" 2>&1 &
    
    local pid=$!
    echo "$pid" > "$WEB_PID_FILE"
    
    # Create symlink to latest log
    ln -sf "$log_file" "$combined_log"
    
    log INFO "Web interface started (PID: $pid, Port: $port)"
    verbose "Waiting for web interface to be ready..."
    
    # Wait for web interface to be ready
    local count=0
    local max_wait=45
    while [[ $count -lt $max_wait ]]; do
        if curl -s -I "http://127.0.0.1:$port" 2>/dev/null | grep -q "200 OK"; then
            log SUCCESS "Web interface is ready on port $port"
            echo -e "${BLUE}Web URL:${NC} http://127.0.0.1:$port"
            return 0
        fi
        
        if ! kill -0 "$pid" 2>/dev/null; then
            log ERROR "Web interface process died during startup"
            log ERROR "Check logs: $log_file"
            tail -10 "$log_file" 2>/dev/null || true
            return 1
        fi
        
        if [[ $((count % 5)) -eq 0 ]] && [[ $count -gt 0 ]]; then
            echo -n " [${count}s]"
        else
            echo -n "."
        fi
        sleep 1
        ((count++))
    done
    
    log ERROR "Web interface failed to start within ${max_wait}s"
    log ERROR "Check logs: $log_file"
    tail -10 "$log_file" 2>/dev/null || true
    return 1
}

# Status checking
status() {
    echo -e "${BOLD}LedgerLoop Service Status${NC}"
    echo "=========================="
    
    local backend_running=false
    local web_running=false
    local backend_port=""
    local web_port=""
    
    # Check backend
    if [[ -f "$BACKEND_PID_FILE" ]]; then
        local pid
        pid="$(cat "$BACKEND_PID_FILE")"
        if kill -0 "$pid" 2>/dev/null; then
            backend_running=true
            [[ -f "$BACKEND_PORT_FILE" ]] && backend_port="$(cat "$BACKEND_PORT_FILE")"
            echo -e "${GREEN}✓${NC} Backend running (PID: $pid, Port: $backend_port)"
        else
            echo -e "${RED}✗${NC} Backend not running (stale PID file)"
        fi
    else
        echo -e "${RED}✗${NC} Backend not running"
    fi
    
    # Check web
    if [[ -f "$WEB_PID_FILE" ]]; then
        local pid
        pid="$(cat "$WEB_PID_FILE")"
        if kill -0 "$pid" 2>/dev/null; then
            web_running=true
            [[ -f "$WEB_PORT_FILE" ]] && web_port="$(cat "$WEB_PORT_FILE")"
            echo -e "${GREEN}✓${NC} Web interface running (PID: $pid, Port: $web_port)"
        else
            echo -e "${RED}✗${NC} Web interface not running (stale PID file)"
        fi
    else
        echo -e "${RED}✗${NC} Web interface not running"
    fi
    
    echo ""
    
    if [[ "$backend_running" == "true" ]]; then
        echo -e "${BLUE}Backend:${NC}  http://127.0.0.1:$backend_port"
        echo -e "${BLUE}API Docs:${NC} http://127.0.0.1:$backend_port/docs"
    fi
    
    if [[ "$web_running" == "true" ]]; then
        echo -e "${BLUE}Web:${NC}      http://127.0.0.1:$web_port"
    fi
    
    # Show recent log entries if verbose
    if [[ $VERBOSE -ge 1 ]]; then
        echo ""
        echo "Recent log entries:"
        [[ -f "$LOGS_DIR/backend.log" ]] && echo -e "${PURPLE}Backend:${NC}" && tail -3 "$LOGS_DIR/backend.log" 2>/dev/null || true
        [[ -f "$LOGS_DIR/web.log" ]] && echo -e "${PURPLE}Web:${NC}" && tail -3 "$LOGS_DIR/web.log" 2>/dev/null || true
    fi
}

# Stop services
stop() {
    local service="${1:-all}"
    
    case "$service" in
        backend)
            log INFO "Stopping backend service"
            kill_process_by_pid_file "$BACKEND_PID_FILE" "backend"
            if [[ -f "$BACKEND_PORT_FILE" ]]; then
                port=$(cat "$BACKEND_PORT_FILE" 2>/dev/null || true)
                kill_on_port "$port"
            fi
            rm -f "$BACKEND_PORT_FILE"
            ;;
        web)
            log INFO "Stopping web service"
            kill_process_by_pid_file "$WEB_PID_FILE" "web"
            if [[ -f "$WEB_PORT_FILE" ]]; then
                port=$(cat "$WEB_PORT_FILE" 2>/dev/null || true)
                kill_on_port "$port"
            fi
            rm -f "$WEB_PORT_FILE"
            ;;
        all)
            log INFO "Stopping all services"
            kill_process_by_pid_file "$BACKEND_PID_FILE" "backend"
            kill_process_by_pid_file "$WEB_PID_FILE" "web"
            if [[ -f "$BACKEND_PORT_FILE" ]]; then kill_on_port "$(cat "$BACKEND_PORT_FILE" 2>/dev/null || true)"; fi
            if [[ -f "$WEB_PORT_FILE" ]]; then kill_on_port "$(cat "$WEB_PORT_FILE" 2>/dev/null || true)"; fi
            rm -f "$BACKEND_PORT_FILE" "$WEB_PORT_FILE"
            cleanup_conflicting_processes
            ;;
        *)
            log ERROR "Unknown service: $service"
            return 1
            ;;
    esac
}

# Restart services
restart() {
    local service="${1:-all}"
    stop "$service"
    sleep 2
    start "$service"
}

# Start services
start() {
    local service="${1:-all}"

    case "$service" in
        backend)
            # Only stop existing backend managed by this script; do not kill web
            kill_process_by_pid_file "$BACKEND_PID_FILE" "backend"
            start_backend
            ;;
        web)
            # Only stop existing web managed by this script; do not kill backend
            kill_process_by_pid_file "$WEB_PID_FILE" "web"
            start_web
            ;;
        all)
            # For full start, clean up broadly once
            cleanup_conflicting_processes
            if start_backend; then
                echo ""
                if start_web; then
                    echo ""
                    echo -e "${BOLD}${GREEN}🎉 LedgerLoop is ready!${NC}"
                    echo "=========================="
                    status
                    echo ""
                    echo -e "${BOLD}Quick Start:${NC}"
                    local web_port
                    local backend_port
                    web_port="$(cat "$WEB_PORT_FILE" 2>/dev/null || echo "3000")"
                    backend_port="$(cat "$BACKEND_PORT_FILE" 2>/dev/null || echo "8000")"
                    echo -e "  • Open your browser to: ${CYAN}http://127.0.0.1:$web_port${NC}"
                    echo -e "  • API documentation: ${CYAN}http://127.0.0.1:$backend_port/docs${NC}"
                    echo -e "  • View logs: ${PURPLE}./start logs${NC}"
                    echo -e "  • Stop services: ${PURPLE}./start stop${NC}"
                else
                    log ERROR "Failed to start web interface"
                    return 1
                fi
            else
                log ERROR "Failed to start backend"
                return 1
            fi
            ;;
        *)
            log ERROR "Unknown service: $service"
            return 1
            ;;
    esac
}

# Logs management
logs() {
    local service="${1:-both}"
    local follow="${2:-}"
    
    case "$service" in
        backend)
            if [[ "$follow" == "-f" ]]; then
                tail -f "$LOGS_DIR/backend.log" 2>/dev/null || log ERROR "No backend logs found"
            else
                cat "$LOGS_DIR/backend.log" 2>/dev/null || log ERROR "No backend logs found"
            fi
            ;;
        web)
            if [[ "$follow" == "-f" ]]; then
                tail -f "$LOGS_DIR/web.log" 2>/dev/null || log ERROR "No web logs found"
            else
                cat "$LOGS_DIR/web.log" 2>/dev/null || log ERROR "No web logs found"
            fi
            ;;
        both)
            echo -e "${PURPLE}=== Backend Logs ===${NC}"
            tail -20 "$LOGS_DIR/backend.log" 2>/dev/null || log ERROR "No backend logs found"
            echo ""
            echo -e "${PURPLE}=== Web Logs ===${NC}"
            tail -20 "$LOGS_DIR/web.log" 2>/dev/null || log ERROR "No web logs found"
            ;;
        *)
            log ERROR "Unknown service: $service. Use 'backend', 'web', or 'both'"
            return 1
            ;;
    esac
}

# Help
show_help() {
    cat << EOF
${BOLD}LedgerLoop Smart Service Manager${NC}

${BOLD}Usage:${NC}
  $0 [OPTIONS] COMMAND [SERVICE]

${BOLD}Commands:${NC}
  start [SERVICE]    Start services (backend, web, or all)
  stop [SERVICE]     Stop services (backend, web, or all)  
  restart [SERVICE]  Restart services
  status             Show service status
  logs [SERVICE]     Show logs (backend, web, or both)
  logs [SERVICE] -f  Follow logs in real-time
  clean              Clean up all processes and session files

${BOLD}Services:${NC}
  backend            FastAPI backend service
  web               Next.js web interface
  all               Both services (default)

${BOLD}Options:${NC}
  -v, --verbose      Enable verbose logging
  -vv                Enable trace logging
  -h, --help         Show this help

${BOLD}Examples:${NC}
  $0 start           Start both services
  $0 start backend   Start only backend
  $0 stop web        Stop only web interface
  $0 restart         Restart both services
  $0 -v start        Start with verbose logging
  $0 logs backend -f Follow backend logs
  $0 status          Show current status

${BOLD}Files:${NC}
  Logs:     $LOGS_DIR/
  Sessions: $SESSIONS_DIR/
EOF
}

# Clean up everything
clean() {
    log INFO "Cleaning up all processes and session files"
    stop all
    cleanup_conflicting_processes
    rm -rf "$SESSIONS_DIR"
    mkdir -p "$SESSIONS_DIR"
    log SUCCESS "Clean up complete"
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -v|--verbose)
            VERBOSE=1
            shift
            ;;
        -vv)
            VERBOSE=2
            shift
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        start|stop|restart|status|logs|clean)
            COMMAND="$1"
            shift
            break
            ;;
        *)
            log ERROR "Unknown option: $1"
            show_help
            exit 1
            ;;
    esac
done

# Set default command
COMMAND="${COMMAND:-start}"

# Execute command
case "$COMMAND" in
    start)
        start "${1:-all}"
        ;;
    stop)
        stop "${1:-all}"
        ;;
    restart)
        restart "${1:-all}"
        ;;
    status)
        status
        ;;
    logs)
        logs "${1:-both}" "${2:-}"
        ;;
    clean)
        clean
        ;;
    *)
        log ERROR "Unknown command: $COMMAND"
        show_help
        exit 1
        ;;
esac
