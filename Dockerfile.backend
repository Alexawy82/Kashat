# Kashat Backend - Production Dockerfile
# Multi-stage build for smaller, more secure image

FROM python:3.12-slim AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install dependencies first (for better layer caching)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir 'uvicorn[standard]' websockets && \
    pip install --no-cache-dir 'bcrypt==4.0.1'

# Production image
FROM python:3.12-slim

# Security: Create non-root user
RUN groupadd -r kashat && useradd -r -g kashat kashat

WORKDIR /app

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy application code
COPY apps/backend/src /app/src
COPY docs/schema.sql /app/

# Set proper permissions
RUN mkdir -p /data && chown -R kashat:kashat /app /data

# Environment
ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV KASHAT_DATA_DIR=/data
ENV KASHAT_ENV=production
ENV KASHAT_LOG_LEVEL=INFO

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health/live')" || exit 1

# Switch to non-root user
USER kashat

EXPOSE 8000

# Use gunicorn for production with uvicorn workers
# IMPORTANT: SQLite only supports single-writer, so use 1 worker
CMD ["gunicorn", "kashat.api.main:app", \
    "--bind", "0.0.0.0:8000", \
    "--workers", "1", \
    "--worker-class", "uvicorn.workers.UvicornWorker", \
    "--access-logfile", "-", \
    "--error-logfile", "-", \
    "--capture-output", \
    "--enable-stdio-inheritance"]
