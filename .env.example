# Kashat Environment Configuration
# Copy this file to .env and adjust values for your environment

# =============================================================================
# Data Storage
# =============================================================================

# Directory for local data (DB, temp files)
# KASHAT_DATA_DIR=~/.kashat

# =============================================================================
# Security Configuration (REQUIRED for production)
# =============================================================================

# JWT Secret Key (REQUIRED - use a strong random string, min 32 chars)
# Generate with: openssl rand -hex 32
# Default (dev only): kashat-dev-secret-change-in-production
KASHAT_JWT_SECRET=your-super-secret-key-change-this-in-production

# Admin API Token for administrative endpoints
# Generate with: openssl rand -hex 24
# KASHAT_ADMIN_TOKEN=

# CORS Allowed Origins (comma-separated list or "*" for all localhost ports)
# Default: http://127.0.0.1:3000,http://localhost:3000
# Production example: https://app.yourdomain.com
# KASHAT_CORS=http://127.0.0.1:3000,http://localhost:3000

# User Registration (disabled by default for single-user personal finance)
# Set to true to allow public registration via POST /api/auth/register
# KASHAT_ALLOW_REGISTRATION=false

# =============================================================================
# Environment & Logging
# =============================================================================

# Environment: development, staging, production
# KASHAT_ENV=development

# Log level: DEBUG, INFO, WARNING, ERROR
# KASHAT_LOG_LEVEL=INFO

# =============================================================================
# AI Configuration
# =============================================================================

# AI Provider: openai, lmstudio, or ollama
# KASHAT_AI_PROVIDER=lmstudio

# LMStudio Base URL (for local AI)
# KASHAT_AI_LMSTUDIO_BASE_URL=http://localhost:1234/v1

# OpenAI API Key (for cloud AI)
# OPENAI_API_KEY=sk-...

# AI Model names (provider-specific)
# KASHAT_AI_MODEL_CATEGORIZE=qwen/qwen3-4b-2507
# KASHAT_AI_MODEL_MERCHANT=qwen/qwen3-4b-2507
# KASHAT_AI_MODEL_ANOMALY=qwen/qwen3-4b-2507

# =============================================================================
# Real-time Features
# =============================================================================

# Enable/disable real-time processing (WebSocket, live updates)
# Set to 'true' to enable, 'false' to disable (reduces CPU usage)
# KASHAT_DISABLE_REALTIME=true

# WebSocket authentication token
# NEXT_PUBLIC_WS_TOKEN=MaroMaro

# =============================================================================
# Rate Limiting
# =============================================================================

# Default rate limit (requests per minute)
# KASHAT_RATE_LIMIT=100/minute

# =============================================================================
# Docker Configuration
# =============================================================================

# Custom ports for Docker deployment
# BACKEND_PORT=8000
# WEB_PORT=3000

# =============================================================================
# Frontend Configuration
# =============================================================================

# API Base URL (for frontend)
# NEXT_PUBLIC_API_BASE=http://localhost:8000/api

# Enable real-time features in UI (0 = disabled, 1 = enabled)
# NEXT_PUBLIC_ENABLE_REALTIME=0

# Enable V1 Complete UI features
# NEXT_PUBLIC_KASHAT_UI_V1_COMPLETE=true
