# LedgerLoop CoreLab Production Environment
# Copy this to .env before deploying

# REQUIRED: Generate with: openssl rand -base64 32
LEDGERLOOP_JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32

# Optional: Admin API token for protected operations
LEDGERLOOP_ADMIN_TOKEN=

# Ports (usually keep defaults)
BACKEND_PORT=8000
WEB_PORT=3000

# AI Configuration
LEDGERLOOP_AI_PROVIDER=lmstudio
LEDGERLOOP_AI_LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1

# Logging
LEDGERLOOP_LOG_LEVEL=INFO
